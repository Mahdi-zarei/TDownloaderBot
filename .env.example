# Copy to .env and fill in the four REQUIRED values. Everything commented out shows its default;
# uncomment a line only to change it. Values with $ or spaces go in single quotes.

# ---------------------------------------------------------------- Telegram
# REQUIRED. Bot token from @BotFather.
BOT_TOKEN=
# REQUIRED. api_id / api_hash from https://my.telegram.org (used by the local Bot API server).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Local Bot API server (all services use host networking and listen on loopback).
# BOT_API_URL=http://127.0.0.1:8081

# ---------------------------------------------------------------- Access
# REQUIRED. Your numeric Telegram user id (ask @userinfobot). Gets error reports and admin commands.
ADMIN_ID=
# Comma-separated user ids allowed to use the bot; empty means anyone. The admin is always allowed.
# ALLOWED_USERS=

# ---------------------------------------------------------------- Paths (inside the container)
# Job temp files; must be the same path in bot and telegram-bot-api.
# DATA_DIR=/data
# SQLite database: file_id cache, users, bans, job history.
# DB_PATH=/state/bot.db
# Netscape-format cookies from burner accounts (see secrets/README.md).
# YOUTUBE_COOKIES=/secrets/youtube-cookies.txt
# INSTAGRAM_COOKIES=/secrets/instagram-cookies.txt

# ---------------------------------------------------------------- Egress
# Named proxies, "name=url,name=url"; "direct" always exists.
# EGRESS_PROXIES=warp=socks5h://127.0.0.1:1080
# With Windscribe (put secrets/windscribe.conf in place and enable the compose profile below):
# EGRESS_PROXIES=warp=socks5h://127.0.0.1:1080,windscribe=socks5h://127.0.0.1:1081
# COMPOSE_PROFILES=windscribe
# Per-source egress: direct, a name from EGRESS_PROXIES, or a proxy URL (socks5h://user:pass@host:port).
# EGRESS_YOUTUBE=warp
# EGRESS_INSTAGRAM=direct
# EGRESS_SOUNDCLOUD=direct
# Any other site yt-dlp supports.
# EGRESS_GENERIC=direct

# ---------------------------------------------------------------- Limits
# Downloads running at once across all users.
# GLOBAL_DOWNLOADS=2
# YouTube downloads at once (protects the egress IP's reputation).
# YOUTUBE_CONCURRENCY=2
# Metadata probes (format lookups) at once.
# PROBE_CONCURRENCY=3
# Jobs per user: running, and waiting in the queue.
# USER_RUNNING=1
# USER_QUEUED=3
# Links handled from a single message.
# MAX_LINKS_PER_MESSAGE=5
# Longest accepted media, in seconds (3 hours).
# MAX_DURATION=10800
# Upload ceiling of the local Bot API server, in MB.
# MAX_UPLOAD_MB=2000
# Qualities estimated above this size (MB) are not offered.
# OFFER_LIMIT_MB=1900

# ---------------------------------------------------------------- Timings (seconds)
# A download is killed after this long.
# JOB_TIMEOUT=1800
# A metadata probe is killed after this long.
# PROBE_TIMEOUT=120
# yt-dlp --sleep-requests for YouTube.
# YOUTUBE_SLEEP_REQUESTS=1.0
# Minimum gap between status-message edits.
# PROGRESS_INTERVAL=4.0
# Quality picker buttons expire after this long.
# PICKER_TTL=900
# An untouched custom-tags card expires after this long.
# TAG_EDITOR_TTL=900
# At most one admin alert per error type per this interval.
# ADMIN_ALERT_INTERVAL=60

# ---------------------------------------------------------------- Monitoring
# Prometheus /metrics listener on the host (host networking). 0 disables it.
# 9091 rather than 9090, which Prometheus itself uses by default.
# METRICS_HOST=127.0.0.1
# METRICS_PORT=9091
# DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO

# ---------------------------------------------------------------- Selftest
# Fixed URLs /selftest runs through every egress.
# SELFTEST_YOUTUBE=https://www.youtube.com/watch?v=jNQXAC9IVRw
# SELFTEST_INSTAGRAM=https://www.instagram.com/p/aye83DjauH/
# SELFTEST_SOUNDCLOUD=https://soundcloud.com/forss/flickermood
# Spotify is checked once (metadata + YouTube match, no download) via YouTube's egress.
# SELFTEST_SPOTIFY=https://open.spotify.com/track/4PTG3Z6ehGkBFwjybzWkR8
